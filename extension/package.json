{
  "name": "gamez-script",
  "displayName": "GameZ Script",
  "description": "GameZ Script editing, validation and navigation for RECOIL and MechWarrior 3 sources.",
  "version": "1.4.0",
  "publisher": "Vorta",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Vorta/GameZ-Script" },
  "engines": { "vscode": "^1.140.0" },
  "categories": ["Programming Languages", "Linters"],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "description": "Document-local highlighting and analysis work; project indexing requires workspace trust." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [{ "id": "gamez-script", "aliases": ["GameZ Script", "gamez-script"], "extensions": [".zad", ".zrd"], "configuration": "./language-configuration.json" }, { "id": "gamez-gamegen", "aliases": ["GameGen Script"], "extensions": [".gs", ".gw"], "configuration": "./gamegen-language-configuration.json" }, { "id": "gamez-animation", "aliases": ["GameZ Animation Script"], "extensions": [".zan"], "configuration": "./animation-language-configuration.json" }],
    "grammars": [{ "language": "gamez-script", "scopeName": "source.gamez", "path": "./syntaxes/gamez.tmLanguage.json" }, { "language": "gamez-gamegen", "scopeName": "source.gamez.gamegen", "path": "./syntaxes/gamegen.tmLanguage.json" }, { "language": "gamez-animation", "scopeName": "source.gamez.animation", "path": "./syntaxes/animation.tmLanguage.json" }],
    "configuration": { "title": "GameZ Script", "properties": { "gamez.dialect": { "type": "string", "enum": ["auto", "recoil", "mw3"], "default": "auto", "scope": "resource", "description": "Game rules for this workspace folder. Auto uses source-model metadata or verified source markers. Unresolved files retain shared syntax assistance until the game is detected or selected in the GameZ status bar." } } },
    "commands": [
      { "command": "gamez.validateProject", "title": "GameZ Script: Validate Project" },
      { "command": "gamez.selectGame", "title": "GameZ Script: Select Game" },
      { "command": "gamez.restartLanguageServer", "title": "GameZ Script: Restart Language Server" }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "test": "node test/grammar.cjs && node test/client.cjs && node test/protocol.cjs && node test/protocol.cjs --restricted && node test/mw3.cjs && node test/mw3.cjs --restricted && node test/profiles.cjs",
    "test:host": "node test/host-runner.cjs",
    "package": "vsce package --target win32-x64 --no-dependencies --out ../artifacts/gamez-script-1.4.0-win32-x64.vsix"
  },
  "dependencies": { "vscode-languageclient": "11.0.0" },
  "overrides": { "@azure/msal-node": "7.1.1" },
  "devDependencies": {
    "@types/node": "26.6.5", "@types/vscode": "1.140.0", "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0", "esbuild": "0.28.2", "typescript": "7.0.2",
    "vscode-textmate": "9.3.2", "vscode-oniguruma": "2.0.1"
  }
}
